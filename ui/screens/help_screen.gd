extends GameScreen
## Краткая справка: управление и как вести расследование.


func build(_args: Dictionary) -> void:
	var p := Ui.panel()
	p.custom_minimum_size = Vector2(1000, 0)
	var v := Ui.vbox(12)
	v.add_child(Ui.header("Как играть", "question", close))
	var g := Ui.grid(2, 18)
	var rows: Array = [
		["Движение", "WASD / стрелки · джойстик слева внизу"],
		["Действие", "E / пробел · большая кнопка справа (подпись меняется: «Поговорить», «Осмотреть»...)"],
		["Лупа", "Q · подсвечивает объекты рядом и раскрывает мелкие детали в документах и багаже"],
		["Журнал", "J · подозреваемые, улики, хронология, диалоги, итог дела"],
		["Камеры", "C · записи камер вагонов: перематывайте и отмечайте подозрительное. В туннелях — помехи, не все вагоны снимаются"],
		["Карта поезда", "M · где вы и где пассажиры"],
		["Пауза", "Esc · также закрывает открытые окна"],
	]
	for r: Array in rows:
		g.add_child(Ui.label(r[0], "GoldLabel", 20))
		var l := Ui.label(r[1], "", 19, true)
		l.custom_minimum_size.x = 700
		g.add_child(l)
	v.add_child(g)
	var tips := Ui.panel("CardPanel")
	var tv := Ui.vbox(6)
	tv.add_child(Ui.label("Советы детектива", "SubHeaderLabel", 22))
	for tip in ["Подозрительное поведение — ещё не вина: у невиновных тоже есть секреты.",
			"Показания могут быть ложью. Сверяйте их с документами и записями камер.",
			"Во вкладке «Улики» выберите две улики и нажмите «Сопоставить» — так появляются выводы.",
			"Доска обвинения: КТО, КАК, КАКОЙ МОНСТР и три улики, связанные выводом. Всё верно — три звезды.",
			"Камера не скажет всего: монстры обманывают запись. Ищите противоречия — человек не может быть в двух местах.",
			"Во «Хронологии» есть доска передвижений: расставьте подозреваемых — и ложное алиби развалится.",
			"Новый вопрос, просмотр записи и проверка стоят минут до станции — цена указана на кнопке.",
			"Если монстр уйдёт, сгорит билет. Билеты восстанавливаются: один каждые 30 минут.",
			"Головоломки (замки, узлы, весы, шифры) решаются по найденным уликам — внизу окна видно, что вы уже знаете. Ошибка стоит минут.",
			"Решающие улики хозяин держит при себе: дождитесь, пока он отойдёт от своих вещей.",
			"Услышали шаги и экран краснеет — прячьтесь: под полкой, под столом, за ящиками. Из укрытия можно подслушать.",
			"Вам что-то предлагают выпить? Решайте: узнаете больше — или останетесь в безопасности. Отравились — ищите противоядие."]:
		tv.add_child(Ui.label("•  " + tip, "", 19, true))
	tips.add_child(tv)
	v.add_child(tips)
	p.add_child(v)
	add_child(Ui.center(p))
