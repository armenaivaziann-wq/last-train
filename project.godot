; Engine configuration file.
config_version=5

[application]

config/name="LAST TRAIN — Кто здесь монстр?"
config/description="Казуальный 2D top-down детектив: найди монстра среди пассажиров ночного поезда."
config/version="0.1.0"
run/main_scene="res://ui/screens/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.06, 0.05, 0.14, 1)

[autoload]

Events="*res://autoload/events.gd"
Db="*res://autoload/db.gd"
SaveManager="*res://autoload/save_manager.gd"
EconomyManager="*res://autoload/economy_manager.gd"
ProgressionManager="*res://autoload/progression_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
UiTheme="*res://autoload/ui_theme.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

